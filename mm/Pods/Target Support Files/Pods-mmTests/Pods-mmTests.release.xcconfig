SVProgressHUD/SVProgressHUD.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftLinkPreview/SwiftLinkPreview.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TOCropViewController/TOCropViewController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TYPagerController/TYPagerController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/TZImagePickerController/TZImagePickerController.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Toast/Toast.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WCDB.swift/WCDBSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WCDBOptimizedSQLCipher/sqlcipher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WKWebViewJavascriptBridge/WKWebViewJavascriptBridge.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YBImageBrowser/YBImageBrowser.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYImage/YYImage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYKit/YYKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZFPlayer/ZFPlayer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/libwebp/libwebp.framework/Headers"
LIBRARY_SEARCH_PATHS = $(inherited) $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"c++" -l"sqlite3" -l"swiftCoreGraphics" -l"z" -framework "AVFoundation" -framework "Accelerate" -framework "AssetsLibrary" -framework "BRPickerView" -framework "CFNetwork" -framework "CTMediator" -framework "CWLateralSlide" -framework "ClusterKit" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreMedia" -framework "CoreServices" -framework "CoreText" -framework "DGCharts" -framework "DZNEmptyDataSet" -framework "DateTools" -framework "FDFullscreenPopGesture" -framework "FLAnimatedImage" -framework "FMDB" -framework "FSCalendar" -framework "Foundation" -framework "HWPanModal" -framework "IQKeyboardManager" -framework "ImageIO" -framework "JSBadgeView" -framework "Kingfisher" -framework "LEEAlert" -framework "LEETheme" -framework "MBProgressHUD" -framework "MapKit" -framework "Masonry" -framework "MediaPlayer" -framework "MobileCoreServices" -framework "Photos" -framework "PhotosUI" -framework "QMUIKit" -framework "QuartzCore" -framework "ReactiveCocoa" -framework "ReactiveObjC" -framework "ReactiveSwift" -framework "SDWebImage" -framework "SVProgressHUD" -framework "Security" -framework "SnapKit" -framework "SwiftLinkPreview" -framework "SystemConfiguration" -framework "TOCropViewController" -framework "TYPagerController" -framework "TZImagePickerController" -framework "Toast" -framework "UIKit" -framework "WCDBSwift" -framework "WKWebViewJavascriptBridge" -framework "YBImageBrowser" -framework "YYImage" -framework "YYKit" -framework "libwebp" -framework "sqlcipher" -weak_framework "Combine" -weak_framework "SwiftUI"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
