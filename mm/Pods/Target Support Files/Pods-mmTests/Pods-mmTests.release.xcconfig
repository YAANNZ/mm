LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift
LIBRARY_SEARCH_PATHS = $(inherited) $(SDKROOT)/usr/lib/swift $(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)/ $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"sqlite3" -l"swiftCoreGraphics" -l"z" -framework "AFNetworking" -framework "AVFoundation" -framework "Accelerate" -framework "Alamofire" -framework "AssetsLibrary" -framework "BRPickerView" -framework "CFNetwork" -framework "CTMediator" -framework "CWLateralSlide" -framework "ClusterKit" -framework "CoreFoundation" -framework "CoreGraphics" -framework "DGCharts" -framework "DZNEmptyDataSet" -framework "DateTools" -framework "FDFullscreenPopGesture" -framework "FLAnimatedImage" -framework "FMDB" -framework "FSCalendar" -framework "Foundation" -framework "HWPanModal" -framework "IQKeyboardManager" -framework "ImageIO" -framework "JSBadgeView" -framework "Kingfisher" -framework "LEEAlert" -framework "LEETheme" -framework "MBProgressHUD" -framework "MapKit" -framework "Masonry" -framework "MediaPlayer" -framework "MobileCoreServices" -framework "Moya" -framework "Photos" -framework "PhotosUI" -framework "QuartzCore" -framework "ReactiveCocoa" -framework "ReactiveObjC" -framework "ReactiveSwift" -framework "SDWebImage" -framework "SVProgressHUD" -framework "SnapKit" -framework "SwiftLinkPreview" -framework "TOCropViewController" -framework "TYPagerController" -framework "TZImagePickerController" -framework "Toast" -framework "UIKit" -framework "WKWebViewJavascriptBridge" -framework "YBImageBrowser" -framework "YTKNetwork" -framework "YYImage" -framework "YYModel" -framework "audio_session" -framework "fluttertoast" -framework "just_audio" -framework "path_provider_foundation" -framework "shared_preferences_foundation" -framework "sqflite_darwin" -weak_framework "Combine" -weak_framework "SwiftUI"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
